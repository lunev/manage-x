{
  "manifest_version": 3,
  "name": "ManageX",
  "description": "Manage, group, and export extensions with rules to enable/disable them by URL.",
  "version": "1.0.0",
  "author": {
    "name": "Alexander Lunev",
    "email": "lunevdev@gmail.com"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "/icons/logo.png",
    "default_title": "ManageX"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "/icons/logo16.png",
    "32": "/icons/logo32.png",
    "48": "/icons/logo48.png",
    "128": "/icons/logo128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "management",
    "sidePanel",
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Ctrl+Shift+E",
        "mac": "Command+Shift+E",
        "chromeos": "Ctrl+Shift+E",
        "linux": "Ctrl+Shift+E"
      }
    }
  }
}
