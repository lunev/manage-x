{
  "manifest_version": 3,
  "name": "ManageX: Extension Manager with URL-based Rules",
  "description": "Smartly enable or disable Chrome extensions based on website URLs!",
  "version": "2.0.0",
  "author": {
    "name": "Alexander Lunev",
    "email": "lunevdev@gmail.com"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/logo.png",
    "default_title": "ManageX"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "management", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Ctrl+Shift+E",
        "mac": "Command+Shift+E",
        "chromeos": "Ctrl+Shift+E",
        "linux": "Ctrl+Shift+E"
      }
    }
  },
  "options_ui": {
    "page": "options.html"
  }
}
